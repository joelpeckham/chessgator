{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,default,template,route,robots,sitemap,manifest}.{ts,tsx}",
    "src/domain/**/index.ts",
    "src/engines/stockfish/index.ts",
    "src/workers/**/*.{ts,tsx}",
    "tests/**/playwright.config.ts",
    "tests/**/*.{spec,test}.{ts,tsx,mjs}",
    "tests/**/build-smoke.mjs",
    "tests/**/static-server.mjs",
    "tests/shared/**/*.{ts,mjs}",
    "scripts/**/*.{js,mjs,ts}"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    "tests/**/*.{ts,tsx,mjs}",
    "scripts/**/*.{js,mjs,ts}"
  ],
  "ignoreDependencies": ["stockfish"],
  "exclude": [
    "types",
    "nsExports",
    "nsTypes",
    "enumMembers",
    "namespaceMembers",
    "duplicates"
  ],
  "ignoreIssues": {
    "src/app/**": ["exports"],
    "src/components/**": ["exports"],
    "src/features/**": ["exports"],
    "src/storage/**": ["exports"],
    "src/lib/**": ["exports"],
    "src/workers/**": ["exports"],
    "tests/**": ["exports"],
    "scripts/**": ["exports"]
  }
}
